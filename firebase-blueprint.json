{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and Free Fire game identity profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 128 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "ffUid": { "type": "string", "maxLength": 30 },
        "ffIgn": { "type": "string", "maxLength": 50 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "fullName", "email", "whatsapp", "ffUid", "ffIgn"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Free Fire tournament information, pricing, schedule, and match credentials",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "mode": { "type": "string", "enum": ["SOLO", "DUO", "SQUAD"] },
        "entryFee": { "type": "number" },
        "prizePool": { "type": "number" },
        "firstPrize": { "type": "number" },
        "secondPrize": { "type": "number" },
        "thirdPrize": { "type": "number" },
        "perKillPrize": { "type": "number" },
        "totalSlots": { "type": "number" },
        "filledSlots": { "type": "number" },
        "matchDate": { "type": "string", "maxLength": 30 },
        "matchTime": { "type": "string", "maxLength": 30 },
        "map": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["UPCOMING", "REGISTRATION_OPEN", "REGISTRATION_CLOSED", "LIVE", "COMPLETED", "CANCELLED"] },
        "bannerUrl": { "type": "string", "maxLength": 500 },
        "rules": { "type": "string", "maxLength": 3000 },
        "roomId": { "type": "string", "maxLength": 100 },
        "roomPassword": { "type": "string", "maxLength": 100 },
        "credentialsPublishedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "mode", "entryFee", "prizePool", "totalSlots", "filledSlots", "matchDate", "matchTime", "map", "status"]
    },
    "Registration": {
      "title": "Registration",
      "description": "User registration record for a tournament",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string", "maxLength": 128 },
        "tournamentTitle": { "type": "string", "maxLength": 150 },
        "tournamentMode": { "type": "string", "maxLength": 20 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "ffUid": { "type": "string", "maxLength": 30 },
        "ffIgn": { "type": "string", "maxLength": 50 },
        "teammateNames": { "type": "string", "maxLength": 300 },
        "paymentId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "CANCELLED"] },
        "slotNumber": { "type": "number" },
        "registeredAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["tournamentId", "userId", "userName", "ffUid", "ffIgn", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "EasyPaisa payment submission and verification record",
      "type": "object",
      "properties": {
        "registrationId": { "type": "string", "maxLength": 128 },
        "tournamentId": { "type": "string", "maxLength": 128 },
        "tournamentTitle": { "type": "string", "maxLength": 150 },
        "entryFee": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "recipientNumber": { "type": "string", "maxLength": 30 },
        "recipientName": { "type": "string", "maxLength": 100 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderPhone": { "type": "string", "maxLength": 30 },
        "transactionId": { "type": "string", "maxLength": 100 },
        "amountPaid": { "type": "number" },
        "screenshotUrl": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "submittedAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["tournamentId", "senderName", "senderPhone", "transactionId", "amountPaid", "status", "userId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User specific notification alerts",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "maxLength": 50 },
        "read": { "type": "boolean" },
        "targetId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message", "read", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Global tournament broadcasts and platform notices",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 50 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "content", "active"]
    },
    "TournamentResult": {
      "title": "TournamentResult",
      "description": "Match winner positions, player stats, and leaderboards",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string", "maxLength": 128 },
        "tournamentTitle": { "type": "string", "maxLength": 150 },
        "matchDate": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "publishedAt": { "type": "string" }
      },
      "required": ["tournamentId", "tournamentTitle", "publishedAt"]
    },
    "PrizeDistribution": {
      "title": "PrizeDistribution",
      "description": "Prize payouts tracking for verified winners",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string", "maxLength": 128 },
        "winnerUid": { "type": "string", "maxLength": 128 },
        "playerName": { "type": "string", "maxLength": 100 },
        "ffUid": { "type": "string", "maxLength": 30 },
        "prizeAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "transactionRef": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["PENDING", "SENT"] },
        "sentAt": { "type": "string" }
      },
      "required": ["tournamentId", "playerName", "ffUid", "prizeAmount", "status"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Dynamic platform configurations, EasyPaisa account, WhatsApp support, and pricing defaults",
      "type": "object",
      "properties": {
        "easyPaisaNumber": { "type": "string", "maxLength": 30 },
        "easyPaisaName": { "type": "string", "maxLength": 100 },
        "whatsappSupportNumber": { "type": "string", "maxLength": 30 },
        "minDeposit": { "type": "number" },
        "defaultSoloFee": { "type": "number" },
        "defaultSoloPrize": { "type": "number" },
        "defaultDuoFee": { "type": "number" },
        "defaultDuoPrize": { "type": "number" },
        "defaultSquadFee": { "type": "number" },
        "defaultSquadPrize": { "type": "number" },
        "rulesUrl": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string" }
      },
      "required": ["easyPaisaNumber", "easyPaisaName", "whatsappSupportNumber"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual gamer profiles"
    },
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Tournament listings, game mode, entry fees, prize pools, and schedule"
    },
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Tournament registration entries with participant info and status"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "User EasyPaisa payments awaiting or verified by admin"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User personal alerts and match updates"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Public system broadcasts and announcements"
    },
    "/tournament_results/{resultId}": {
      "schema": "TournamentResult",
      "description": "Published winner results and leaderboards"
    },
    "/prize_distributions/{prizeId}": {
      "schema": "PrizeDistribution",
      "description": "Prize transfer tracking records"
    },
    "/app_settings/{settingId}": {
      "schema": "AppSetting",
      "description": "Global application configuration documents"
    }
  }
}
